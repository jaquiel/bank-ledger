<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Isola o restore das fontes configuradas na máquina (NU1507 com Central Package Management).
    Todos os pacotes vêm do nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

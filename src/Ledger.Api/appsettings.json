{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ledger": ""
  },
  "Auth": {
    "Authority": "",
    "Audience": "ledger-api"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "LockTimeoutMs": 3000,
    "StatementTimeoutMs": 5000,
    "MaxTransientRetries": 2
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalMs": 1000,
    "BatchSize": 100
  },
  "RateLimiting": {
    "TokenLimit": 200,
    "TokensPerPeriod": 100,
    "ReplenishmentPeriodMs": 1000
  }
}
